        dayKey INT64,
        deletedAt TIMESTAMP,
        isSkipped INT64,
        minuteOfDayOverride INT64,
        slotID STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE PlanSlot (
        "___recordID" REFERENCE QUERYABLE,
        assignedToColorHex STRING,
        assignedToID STRING,
        assignedToName STRING,
        createdAt TIMESTAMP,
        deletedAt TIMESTAMP,
        endMinuteOfDay INT64,
        kindRaw STRING,
        minuteOfDay INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE PottyEvent (
        "___recordID" REFERENCE QUERYABLE,
        babyID STRING,
        deletedAt TIMESTAMP,
        editOfID STRING,
        externalID STRING,
        loggedByColorHex STRING,
        loggedByID STRING,
        loggedByName STRING,
        notes STRING,
