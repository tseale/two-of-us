        timestamp TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SharedSettings (
        "___recordID" REFERENCE QUERYABLE,
        aiPredictionsEnabled INT64,
        brightwheelStatus STRING,
        daycareAddress STRING,
        daycareCloseMinute INT64,
        daycareDaysRaw STRING,
        daycareGeofenceEnabled INT64,
        daycareGeofenceRadiusMeters DOUBLE,
        daycareLocation STRING,
        daycareName STRING,
        daycareOpenMinute INT64,
        daycarePhone STRING,
        daycarePickupShowMinute INT64,
        daycarePresence STRING,
        daycareRoom STRING,
        defaultFeedOz DOUBLE,
        diaperLoggingEnabled INT64,
        feedLoggingEnabled INT64,
        nightEndMinute INT64,
        nightFeedSpacingMinutes INT64,
        nightFirstFeedMinute INT64,
        nightFirstShiftID STRING,
        nightRotationRaw STRING,
        nightStartMinute INT64,
        ozPresets LIST<DOUBLE>,
        sleepLoggingEnabled INT64,
        snooCredentials STRING,
        targetFeedIntervalMinutes INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SleepEvent (
        "___recordID" REFERENCE QUERYABLE,
        babyID STRING,
        deletedAt TIMESTAMP,
        editOfID STRING,
        endedAt TIMESTAMP,
        externalID STRING,
        loggedByColorHex STRING,
        loggedByID STRING,
        loggedByName STRING,
        notes STRING,
        sourceRaw STRING,
        startedAt TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE StaffNoteEvent (
        "___recordID" REFERENCE QUERYABLE,
        authorName STRING,
        babyID STRING,
        deletedAt TIMESTAMP,
        editOfID STRING,
        externalID STRING,
        loggedByColorHex STRING,
        loggedByID STRING,
        loggedByName STRING,
        sourceRaw STRING,
        text STRING,
        timestamp TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___recordID" REFERENCE,
        roles LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    RECORD TYPE "cloudkit.share" (
        "___recordID" REFERENCE QUERYABLE,
        "cloudkit.thumbnailImageData" BYTES,
        "cloudkit.title" STRING,
        "cloudkit.type" STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );
