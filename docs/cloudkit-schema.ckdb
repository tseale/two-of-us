// CloudKit schema for iCloud.com.taylorseale.twoofus — generated from
// TwoOfUs/Sync/RecordMapping.swift (the authoritative field list).
// Import via CloudKit Console → Import Schema, or:
//   xcrun cktool import-schema --team-id Q58H65DQ64 \
//     --container-id iCloud.com.taylorseale.twoofus \
//     --environment development --file docs/cloudkit-schema.ckdb
//
// "___recordID" QUERYABLE lets the Console query records by type (sync itself
// never queries — CKSyncEngine uses zone deltas). No other indexes on purpose.
//
// Users and "cloudkit.share" are declared so an import never drops them:
// Production won't JIT-create share fields, and makeShare sets title+thumbnail
// (the missing-share-type failure of 2026-06-12).
DEFINE SCHEMA

    RECORD TYPE ActivityEvent (
        "___recordID" REFERENCE QUERYABLE,
        babyID STRING,
        deletedAt TIMESTAMP,
        durationMinutes INT64,
        editOfID STRING,
        externalID STRING,
        loggedByColorHex STRING,
        loggedByID STRING,
        loggedByName STRING,
        notes STRING,
        sourceRaw STRING,
        timestamp TIMESTAMP,
        typeRaw STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Baby (
        "___recordID" REFERENCE QUERYABLE,
        createdAt TIMESTAMP,
        dateOfBirth TIMESTAMP,
        name STRING,
        photoData ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CheckEvent (
        "___recordID" REFERENCE QUERYABLE,
        babyID STRING,
        byName STRING,
        deletedAt TIMESTAMP,
        editOfID STRING,
        externalID STRING,
        loggedByColorHex STRING,
        loggedByID STRING,
        loggedByName STRING,
        notes STRING,
        sourceRaw STRING,
        timestamp TIMESTAMP,
        typeRaw STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE DiaperEvent (
        "___recordID" REFERENCE QUERYABLE,
        babyID STRING,
        deletedAt TIMESTAMP,
        editOfID STRING,
        externalID STRING,
        loggedByColorHex STRING,
        loggedByID STRING,
        loggedByName STRING,
        notes STRING,
        sourceRaw STRING,
        timestamp TIMESTAMP,
        typeRaw STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE FeedEvent (
        "___recordID" REFERENCE QUERYABLE,
        amountOz DOUBLE,
        babyID STRING,
        deletedAt TIMESTAMP,
        editOfID STRING,
        externalID STRING,
        loggedByColorHex STRING,
        loggedByID STRING,
        loggedByName STRING,
        notes STRING,
        sourceRaw STRING,
        timestamp TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE HealthCheckEvent (
        "___recordID" REFERENCE QUERYABLE,
        babyID STRING,
        deletedAt TIMESTAMP,
        editOfID STRING,
        externalID STRING,
        loggedByColorHex STRING,
        loggedByID STRING,
        loggedByName STRING,
        notes STRING,
        sourceRaw STRING,
        timestamp TIMESTAMP,
        typeRaw STRING,
        value DOUBLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE MediaEvent (
        "___recordID" REFERENCE QUERYABLE,
        babyID STRING,
        caption STRING,
        deletedAt TIMESTAMP,
        editOfID STRING,
        externalID STRING,
        kindRaw STRING,
        loggedByColorHex STRING,
        loggedByID STRING,
        loggedByName STRING,
        mediaData ASSET,
        remoteURL STRING,
        sourceRaw STRING,
        timestamp TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE MedicationEvent (
        "___recordID" REFERENCE QUERYABLE,
        administeredBy STRING,
        babyID STRING,
        deletedAt TIMESTAMP,
        dosage STRING,
        editOfID STRING,
        externalID STRING,
        loggedByColorHex STRING,
        loggedByID STRING,
        loggedByName STRING,
        name STRING,
        notes STRING,
        sourceRaw STRING,
        timestamp TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE MilestoneEvent (
        "___recordID" REFERENCE QUERYABLE,
        babyID STRING,
        categoryRaw STRING,
        deletedAt TIMESTAMP,
        editOfID STRING,
        externalID STRING,
        loggedByColorHex STRING,
        loggedByID STRING,
        loggedByName STRING,
        notes STRING,
        photoData ASSET,
        sourceRaw STRING,
        text STRING,
        timestamp TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE MoodEvent (
        "___recordID" REFERENCE QUERYABLE,
        babyID STRING,
        deletedAt TIMESTAMP,
        editOfID STRING,
        externalID STRING,
        levelRaw STRING,
        loggedByColorHex STRING,
        loggedByID STRING,
        loggedByName STRING,
        notes STRING,
        sourceRaw STRING,
        timestamp TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE NoteEvent (
        "___recordID" REFERENCE QUERYABLE,
        babyID STRING,
        deletedAt TIMESTAMP,
        editOfID STRING,
        externalID STRING,
        loggedByColorHex STRING,
        loggedByID STRING,
        loggedByName STRING,
        sourceRaw STRING,
        text STRING,
        timestamp TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Participant (
        "___recordID" REFERENCE QUERYABLE,
        cloudUserID STRING,
        colorHex STRING,
        displayName STRING,
        invitedAt TIMESTAMP,
        isActive INT64,
